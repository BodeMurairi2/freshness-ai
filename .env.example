# Freshness-ai API settings. Copy this file to .env and fill in the values marked <...>.
# Never commit .env: it holds passwords and keys.
# Lists are written as JSON, e.g. ["a", "b"].

# ---------------------------------------------------------------- API documentation
# Swagger (/docs), ReDoc (/redoc) and /openapi.json: hidden unless true
DOCS_ENABLED=false

# ---------------------------------------------------------------- CORS
# Addresses of the frontend allowed to call the API (no trailing slash)
# Local development: ["http://localhost:5173", "http://127.0.0.1:5173"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
CORS_ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]

# ---------------------------------------------------------------- Hugging Face (optional)
# Only used by scripts/download_samples.py
HF_TOKEN=<your-hugging-face-token>

# ---------------------------------------------------------------- Uploaded images
IMAGE_ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"]
# Maximum size of one image, in MB
IMAGE_ALLOWED_SIZE=10

# ---------------------------------------------------------------- Prediction
# Below this confidence (0-1), a prediction is marked as uncertain
DECISION_THRESHOLD=0.75
# Keep prediction photos (unlabelled) in R2 to improve the model later; set false during load tests
SAVE_PREDICTION_IMAGES=true

# ---------------------------------------------------------------- Model input size
# Must match the model: [height, width]
IMAGE_SIZE=[224, 224]

# ---------------------------------------------------------------- Retraining
# Epochs used when the user does not choose, and the most a user may choose
RETRAIN_EPOCHS=2
RETRAIN_MAX_EPOCHS=10
RETRAIN_LEARNING_RATE=0.0001
# Uploaded images needed before retraining can start
RETRAIN_MIN_IMAGES=4
# Decoded images held in memory to shuffle the training data (512 uses about 0.3 GB)
RETRAIN_SHUFFLE_BUFFER=512

# ---------------------------------------------------------------- MongoDB Atlas
MONGODB_USERNAME=<database-user>
MONGODB_PASSWORD=<database-password>
# From Atlas: Database > Connect > Drivers (letters and digits in the password avoid URL encoding)
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=freshness_ai

# ---------------------------------------------------------------- Cloudflare R2 (image storage)
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=freshness-data
# Public development URL of the bucket (Settings > Public Development URL)
R2_PUBLIC_URL=https://pub-<id>.r2.dev
# "eu" for buckets created in the EU jurisdiction, leave empty otherwise
R2_BUCKET_JURISDICTION=eu

# ---------------------------------------------------------------- Authentication (JWT)
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<long-random-string>
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------- Email (Gmail SMTP, password codes)
# Gmail address and a Google app password (Google account > Security > App passwords), without spaces
SMTP_USERNAME=<your-address@gmail.com>
SMTP_APP_PASSWORD=<16-character-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_SENDER_NAME=Freshness-ai
# Lifetime of a password code, in minutes
PASSWORD_CODE_MINUTES=10
